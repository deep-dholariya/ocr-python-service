# =============================================================================
# PYTHON OCR SERVICE — ENVIRONMENT CONFIGURATION
# Copy this file to `.env` for local runs. On Render, set these as
# environment variables in the service dashboard instead.
# =============================================================================

# Port the Flask/gunicorn server listens on.
# Render sets this automatically — you normally don't need to set it there.
PORT=5001

# Maximum accepted upload size in bytes. Should match (or exceed) the
# Node service's MAX_FILE_SIZE. 10485760 = 10 MB.
MAX_FILE_SIZE=10485760
